{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar archivo activo",
            "type": "shell",
            "command": "clang++",
            "args": [
                "-std=c++17",
                "-stdlib=libc++",
                "-O2",

                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-Wnull-dereference",
                "-Wshadow",

                "-o",
                "${workspaceFolder}/main",
                "${file}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": "$gcc"
        }
    ]
}